# Salin file ini menjadi .env lalu isi nilainya
# Windows: copy .env.example .env

# ── Flask ─────────────────────────────────────────────────────────────────────
SECRET_KEY=ganti-dengan-string-acak-panjang
FLASK_DEBUG=0

# ── Auth ──────────────────────────────────────────────────────────────────────
APP_USERNAME=admin
APP_PASSWORD=ganti-dengan-password-kuat

# ── Supabase (persistent database) ───────────────────────────────────────────
# Daftar gratis di https://supabase.com → buat project → Settings → API
# Ubah USE_SUPABASE menjadi 1 setelah mengisi URL dan KEY
USE_SUPABASE=0
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxx

# ── Cloud Storage (opsional, untuk upload file persisten) ─────────────────────
# Daftar gratis di https://cloudinary.com
USE_CLOUDINARY=0
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
